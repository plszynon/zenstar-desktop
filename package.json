{
  "name": "zenstar-desktop",
  "version": "1.0.0",
  "description": "ZenStar - przegladarka desktopowa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.zenstar.desktop",
    "productName": "ZenStar",
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "renderer/**/*",
      "adblock_hosts.txt",
      "build/icon.ico"
    ]
  }
}
